LOGIN = "sforesti"
SERVER_IP = "192.168.56.110"
WORKER_IP = "192.168.56.111"
K3S_TOKEN = "b74487613b60ae65549de6369ff80dde178c65838527233ec0b2df52194b7eb8"
DOCKERHUB = { "DOCKERHUB_USER" => ENV.fetch("DOCKERHUB_USER", ""), "DOCKERHUB_TOKEN" => ENV.fetch("DOCKERHUB_TOKEN", "") }

Vagrant.configure("2") do |config|
  config.vm.box              = "rockylinux-10"
  config.vm.box_url          = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box"
  config.vm.box_check_update = false
  config.vm.boot_timeout     = 900

  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provision "shell", run: "always", inline: <<-'SHELL'
    IFACE=$(ip -o -4 addr show | grep -F "192.168.56." | awk '{print $2}')
    CON=$(nmcli -g GENERAL.CONNECTION device show "$IFACE")
    restorecon -R /etc/NetworkManager/system-connections
    nmcli connection modify "$CON" ipv4.never-default yes
    nmcli connection up "$CON" > /dev/null
    ip route | grep default
  SHELL

  config.vm.provider "virtualbox" do |vb|
    vb.cpus   = 2
    vb.memory = 2048
    vb.customize ["modifyvm", :id, "--paravirt-provider", "kvm"]
  end

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP
    server.vm.provision "shell", path: "scripts/dockerhub_auth.sh", env: DOCKERHUB
    server.vm.provision "shell", path: "scripts/k3s.server.sh", args: [SERVER_IP, K3S_TOKEN]

    server.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}S"
    end
  end

  config.vm.define "#{LOGIN}SW" do |worker|
    worker.vm.hostname = "#{LOGIN}SW"
    worker.vm.network "private_network", ip: WORKER_IP
    worker.vm.provision "shell", path: "scripts/dockerhub_auth.sh", env: DOCKERHUB
    worker.vm.provision "shell", path: "scripts/k3s.worker.sh", args: [SERVER_IP, WORKER_IP, K3S_TOKEN]

    worker.vm.provider "virtualbox" do |vb|
      vb.name   = "#{LOGIN}SW"
      vb.cpus   = 1
      vb.memory = 1024
    end
  end
end