LOGIN = "sforesti"
SERVER_IP = "192.168.56.110"
K3S_TOKEN = "b74487613b60ae65549de6369ff80dde178c65838527233ec0b2df52194b7eb8"

Vagrant.configure("2") do |config|
  config.vm.box              = "rockylinux-10"
  config.vm.box_url          = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box"
  config.vm.box_check_update = false

  # La box Rocky n'a pas les Guest Additions VirtualBox,
  # donc le dossier partagé /vagrant ne peut pas fonctionner.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP
    server.vm.provision "file", source: "confs", destination: "/tmp/confs"
    server.vm.provision "shell", path: "scripts/k3s.server.sh", args: [SERVER_IP, K3S_TOKEN]

    server.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}S"
      vb.cpus   = 2
      vb.memory = 4096
    end
  end
end